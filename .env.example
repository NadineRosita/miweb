# Copia este archivo como .env para trabajar en local. El .env nunca se sube a git.
# En Railway no hace falta: allí estas variables se configuran en el panel.

# Conexión a PostgreSQL. Sin ella la web funciona, pero Mi Pet queda desactivado.
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/nadineross

# Puerto del servidor local (Railway define el suyo automáticamente)
PORT=3000
