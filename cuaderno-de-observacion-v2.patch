-  border-radius: 22px 22px 60% 60% / 22px 22px 25% 25%;
-  pointer-events: none;
-}
-
-body[data-page="juegos"] .card > * {
-  position: relative;
-}
-
-body[data-page="juegos"] .card-text {
-  color: #1d5a85;
-}
-
-body[data-page="juegos"] .game-card:hover,
-body[data-page="juegos"] .game-card:focus-visible {
-  border-color: #fff;
-  transform: translateY(-4px) scale(1.02);
-  box-shadow:
-    0 12px 30px rgba(0, 120, 220, 0.45),
-    0 0 22px rgba(255, 255, 255, 0.8),
-    inset 0 1px 0 #fff,
-    inset 0 -10px 20px rgba(80, 190, 255, 0.35);
-}
-
-/* Icono como orbe de cristal verde-azulado */
-body[data-page="juegos"] .game-icon {
-  box-sizing: content-box;
-  width: 2.6rem;
-  height: 2.6rem;
-  padding: 0.5rem;
-  fill: #fff;
-  background: radial-gradient(circle at 30% 25%, #b8ffd0, #27c4a8 55%, #0a8fb8);
-  border-radius: 50%;
-  border: 2px solid rgba(255, 255, 255, 0.9);
-  box-shadow: 0 4px 10px rgba(0, 110, 170, 0.45), inset 0 -6px 10px rgba(0, 90, 140, 0.35);
-  filter: drop-shadow(0 1px 1px rgba(0, 70, 110, 0.5));
-}
-
-body[data-page="juegos"] .card-title {
-  color: #0a4a7a;
-  text-shadow: 0 1px 0 #fff;
-}
-
-/* "Jugar" como botón de gel */
-body[data-page="juegos"] .card-link {
-  align-self: flex-start;
-  padding: 0.35rem 1.1rem;
-  color: #fff;
-  text-shadow: 0 1px 2px rgba(0, 80, 40, 0.6);
-  background: linear-gradient(180deg, #8df29a 0%, #3fc95a 50%, #22a342 51%, #52d46c 100%);
-  border: 1px solid #1c8a37;
-  border-radius: 100px;
-  box-shadow: 0 3px 8px rgba(0, 100, 40, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.8);
-}
