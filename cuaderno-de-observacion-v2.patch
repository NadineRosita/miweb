diff --git a/public/css/inicio.css b/public/css/inicio.css
new file mode 100644
index 0000000..202c1b2
--- /dev/null
+++ b/public/css/inicio.css
@@ -0,0 +1,503 @@
+/* ============================================================
+   INICIO: «Cuaderno de observación»
+   La página es una noche mirando la luna. La luna grande cambia
+   de fase con el scroll y la barra de fases es el índice.
+   Se carga después de styles.css y solo afecta a Inicio.
+   ============================================================ */
+
+/* La luna de Inicio ya es la grande: fuera el sol/luna común del fondo */
+body[data-page="inicio"] .sky {
+  display: none;
+}
+
+:root[data-theme="light"] body[data-page="inicio"] .luna-luz {
+  fill: #fbf7ea;
+}
+
+/* ---------- La luna grande ---------- */
+.luna-grande {
+  position: fixed;
+  top: 50%;
+  right: -9vw;
+  z-index: -1;
+  width: min(74vh, 44vw);
+  aspect-ratio: 1;
+  transform: translateY(-46%);
+  pointer-events: none;
+}
+
+.luna-svg {
+  display: block;
+  width: 100%;
+  height: 100%;
+  overflow: visible;
+  /* Cuanta más luna, más halo */
+  filter: drop-shadow(0 0 calc(var(--luz, 0) * 70px) rgba(241, 228, 174, calc(var(--luz, 0) * 0.22)));
+}
+
+.luna-sombra {
+  fill: var(--sombra-luna);
+}
+
+.luna-luz {
+  fill: var(--luz-luna);
+}
+
+.luna-crateres {
+  fill: var(--crater);
+}
+
+.luna-ceniza {
+  fill: rgba(233, 227, 211, 0.025);
+}
+
+.luna-borde {
+  fill: none;
+  stroke: var(--linea);
+  stroke-width: 0.6;
+}
+
+/* ---------- Índice de fases ---------- */
+.fases {
+  position: fixed;
+  top: 50%;
+  left: 2rem;
+  z-index: 10;
+  transform: translateY(-50%);
+}
+
+.fases ol {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  gap: 0.35rem;
+  list-style: none;
+}
+
+/* El hilo que une las lunas se va llenando con la noche */
+.fases ol::before,
+.fases ol::after {
+  content: '';
+  position: absolute;
+  top: 1.1rem;
+  bottom: 1.1rem;
+  left: calc(0.6rem + 10px);
+  width: 1px;
+  background: var(--linea);
+}
+
+.fases ol::after {
+  bottom: auto;
+  height: calc((100% - 2.2rem) * var(--fill, 0));
+  background: var(--luz-luna);
+}
+
+.fases li {
+  position: relative;
+  z-index: 1; /* Las lunas por encima del hilo */
+}
+
+.fase {
+  display: flex;
+  align-items: center;
+  gap: 0.75rem;
+  padding: 0.5rem 0.6rem;
+  border-radius: 999px;
+  font-size: 0.875rem;
+  color: var(--grafito);
+  transition: color 0.3s ease;
+}
+
+.luna-fase {
+  position: relative;
+  flex-shrink: 0;
+  width: 20px;
+  height: 20px;
+  background: var(--noche);
+  border-radius: 50%;
+}
+
+.luna-fase .luna-borde {
+  stroke: rgba(var(--ink-rgb), 0.35);
+  stroke-width: 1;
+}
+
+.fase-nombre {
+  opacity: 0.75;
+  transition: opacity 0.3s ease;
+}
+
+.fase:hover,
+.fase[aria-current] {
+  color: var(--papel);
+}
+
+.fase:hover .fase-nombre,
+.fase[aria-current] .fase-nombre {
+  opacity: 1;
+}
+
+.fase[aria-current] .luna-fase {
+  box-shadow: 0 0 0 4px var(--noche), 0 0 0 5px var(--luz-luna);
+}
+
+/* ---------- Columna de texto ---------- */
+body[data-page="inicio"] main {
+  padding-top: 0;
+}
+
+.cuaderno {
+  width: min(100% - 2.5rem, 40rem);
+  margin-left: clamp(12.5rem, 17vw, 16rem);
+}
+
+.cuaderno > section,
+.cuaderno > header {
+  padding-block: 7rem 2rem;
+  scroll-margin-top: 4rem;
+}
+
+.titulo-seccion {
+  margin-bottom: 1.25rem;
+  font-family: var(--font-title);
+  font-size: clamp(2.75rem, 6vw, 4.25rem);
+  font-weight: 400;
+  line-height: 1;
+  letter-spacing: -0.01em;
+}
+
+.texto-seccion {
+  max-width: 34em;
+  margin-bottom: 1rem;
+  color: var(--white2);
+}
+
+.subtitulo {
+  margin: 4.5rem 0 0.5rem;
+  font-family: var(--font-title);
+  font-style: italic;
+  font-size: 1.75rem;
+  font-weight: 400;
+  color: var(--grafito);
+}
+
+/* ---------- Presentación ---------- */
+.presentacion {
+  display: flex;
+  flex-direction: column;
+  justify-content: flex-end;
+  min-height: 100svh;
+}
+
+.cuaderno > .presentacion {
+  padding-block: 7rem 4.5rem;
+}
+
+.nombre {
+  margin-left: -0.05em; /* La N alinea su trazo, no su caja, con el texto */
+  margin-bottom: 1.75rem;
+  font-family: var(--font-title);
+  font-size: clamp(4.25rem, 11.5vw, 9.5rem);
+  font-weight: 400;
+  line-height: 0.88;
+  letter-spacing: -0.025em;
+  text-wrap: balance;
+}
+
+.entradilla {
+  max-width: 30em;
+  margin-bottom: 2rem;
+  font-size: 1.1875rem;
+  line-height: 1.55;
+  color: var(--white2);
+}
+
+.acciones {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.75rem;
+}
+
+.luna-hoy {
+  display: flex;
+  align-items: center;
+  gap: 0.65rem;
+  margin-top: 3rem;
+  font-size: 0.875rem;
+  color: var(--grafito);
+}
+
+.luna-mini {
+  flex-shrink: 0;
+  width: 18px;
+  height: 18px;
+}
+
+.luna-mini .luna-borde {
+  stroke: rgba(var(--ink-rgb), 0.35);
+  stroke-width: 1.5;
+}
+
+/* La fórmula dibuja siempre la luz a la derecha; menguando va a la izquierda */
+.luna-menguando {
+  transform: scaleX(-1);
+}
+
+/* El único momento con movimiento propio: el nombre sale de la oscuridad
+   mientras la luna grande pasa de nueva a su primer hilo de luz */
+@media (prefers-reduced-motion: no-preference) {
+  .nombre {
+    animation: amanece 1.6s cubic-bezier(0.2, 0.7, 0.2, 1) both;
+  }
+
+  .entradilla,
+  .acciones,
+  .luna-hoy {
+    animation: amanece 1.6s cubic-bezier(0.2, 0.7, 0.2, 1) 0.35s both;
+  }
+}
+
+@keyframes amanece {
+  from {
+    opacity: 0;
+    filter: blur(6px);
+  }
+}
+
+/* ---------- Observaciones (proyectos) ---------- */
+.obs-lista {
+  margin-top: 2.5rem;
+}
+
+.obs {
+  display: grid;
+  grid-template-columns: 8.5rem 1fr;
+  gap: 0 1.5rem;
+  padding-block: 1.75rem;
+  border-top: 1px solid var(--linea);
+}
+
+.obs-destacada {
+  padding-block: 2.5rem;
+}
+
+.obs-destacada .estado {
+  padding-top: 0.9rem;
+}
+
+.obs-titulo {
+  margin-bottom: 0.4rem;
+  font-family: var(--font-title);
+  font-size: 1.75rem;
+  font-weight: 400;
+  line-height: 1.15;
+}
+
+.obs-destacada .obs-titulo {
+  font-size: clamp(2.25rem, 4vw, 2.75rem);
+  line-height: 1.05;
+}
+
+.obs-texto {
+  margin-bottom: 0.75rem;
+  color: var(--white2);
+}
+
+.obs-destacada .obs-texto {
+  font-size: 1.125rem;
+  color: var(--papel);
+}
+
+.obs-dentro {
+  margin-bottom: 0.9rem;
+  font-size: 0.9375rem;
+  color: var(--white2);
+}
+
+.obs-dentro strong {
+  font-family: var(--font-title);
+  font-style: italic;
+  font-size: 1.15em;
+  font-weight: 400;
+  color: var(--papel);
+}
+
+.pila {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.15rem 1rem;
+  margin-bottom: 1.25rem;
+  list-style: none;
+  font-size: 0.8125rem;
+  color: var(--grafito);
+  font-variant-numeric: tabular-nums;
+}
+
+.obs:not(.obs-destacada) .pila:last-child {
+  margin-bottom: 0;
+}
+
+/* ---------- Notas (sobre mí y herramientas) ---------- */
+.notas {
+  margin-top: 2.25rem;
+}
+
+.nota {
+  display: grid;
+  grid-template-columns: 8.5rem 1fr;
+  gap: 0 1.5rem;
+  padding-block: 0.9rem;
+  border-top: 1px solid var(--linea);
+}
+
+.nota dt {
+  font-size: 0.875rem;
+  color: var(--grafito);
+  padding-top: 0.15rem;
+}
+
+.nota dd {
+  color: var(--papel);
+}
+
+.herramientas em {
+  font-family: var(--font-title);
+  font-size: 1.15em;
+  color: var(--white2);
+}
+
+/* ---------- Contacto ---------- */
+.cuaderno > #contacto {
+  padding-bottom: 8rem;
+}
+
+.titulo-contacto {
+  font-size: clamp(3.5rem, 9vw, 6.5rem);
+}
+
+.correo {
+  display: inline-block;
+  margin: 1.25rem 0 1.75rem;
+  font-family: var(--font-title);
+  font-size: clamp(1.6rem, 4.6vw, 3rem);
+  line-height: 1.1;
+  overflow-wrap: anywhere;
+  text-decoration: underline;
+  text-decoration-thickness: 1px;
+  text-underline-offset: 0.18em;
+  text-decoration-color: rgba(var(--ink-rgb), 0.35);
+  transition: text-decoration-color 0.25s ease;
+}
+
+.correo:hover {
+  text-decoration-color: var(--luz-luna);
+}
+
+.aviso {
+  min-height: 1.5em;
+  margin-top: 0.75rem;
+  font-size: 0.875rem;
+  color: var(--grafito);
+}
+
+.redes {
+  margin-top: 1.5rem;
+  color: var(--white2);
+}
+
+/* ---------- Pantallas medianas: la luna se aparta del texto ---------- */
+@media (max-width: 1280px) {
+  .luna-grande {
+    right: -16vw;
+    width: min(70vh, 46vw);
+  }
+}
+
+/* ---------- Móvil y tableta ---------- */
+@media (max-width: 1000px) {
+  .cuaderno {
+    width: auto;
+    margin-inline: 1.5rem;
+  }
+
+  .luna-grande {
+    top: 4.5rem;
+    right: -22vw;
+    width: 70vw;
+    opacity: 0.38;
+    transform: none;
+  }
+
+  .presentacion {
+    min-height: 92svh;
+  }
+
+  /* El índice baja a una barra: las cinco lunas y el nombre de donde estás */
+  .fases {
+    top: auto;
+    bottom: 1rem;
+    left: 50%;
+    transform: translateX(-50%);
+    padding: 0.2rem 0.4rem;
+    background: rgba(var(--bg-rgb), 0.88);
+    -webkit-backdrop-filter: blur(14px);
+    backdrop-filter: blur(14px);
+    border: 1px solid var(--linea);
+    border-radius: 999px;
+  }
+
+  .fases ol {
+    flex-direction: row;
+    gap: 0;
+  }
+
+  .fases ol::before,
+  .fases ol::after {
+    display: none;
+  }
+
+  .fase {
+    min-width: 2.75rem;
+    min-height: 2.75rem;
+    justify-content: center;
+    padding: 0.5rem 0.6rem;
+    gap: 0.5rem;
+  }
+
+  .fase-nombre {
+    display: none;
+  }
+
+  .fase[aria-current] .fase-nombre {
+    display: inline;
+    white-space: nowrap;
+  }
+
+  .fase[aria-current] .luna-fase {
+    box-shadow: none;
+  }
+
+  body[data-page="inicio"] .footer {
+    padding-bottom: 5rem; /* Que la barra de fases no tape el pie */
+  }
+}
+
+@media (max-width: 600px) {
+  .obs,
+  .nota {
+    grid-template-columns: 1fr;
+  }
+
+  .estado,
+  .obs-destacada .estado {
+    padding: 0 0 0.6rem;
+  }
+
+  .nota dt {
+    padding: 0 0 0.2rem;
+  }
+
+  .cuaderno > section {
+    padding-top: 5rem;
+  }
+}
diff --git a/public/css/juegos.css b/public/css/juegos.css
new file mode 100644
index 0000000..6765b30
--- /dev/null
+++ b/public/css/juegos.css
@@ -0,0 +1,381 @@
+/* ============================================================
+   JUEGOS: Frutiger Aero dentro del cuaderno
+   De noche (tema oscuro): una laguna bajo la luna, con cristal,
+   burbujas y botones de gel en aguamarina.
+   De día (tema claro): el aero de siempre, cielo azul y colina verde.
+   Las letras, los colores del texto y la barra son los de toda la web.
+   ============================================================ */
+
+body[data-page="juegos"] {
+  /* Colores propios del aero nocturno */
+  --aqua: #5fe6d4;
+  --aqua-hondo: #109fb2;
+  --cristal-fondo: linear-gradient(180deg, rgba(150, 220, 255, 0.16), rgba(40, 120, 170, 0.07));
+  --cristal-borde: rgba(190, 235, 255, 0.3);
+  --cristal-brillo: rgba(255, 255, 255, 0.16);
+  --cristal-texto: #c9dcea;
+  --cristal-dato: #8fd3e0;
+  --gel: linear-gradient(180deg, #c4fff4 0%, #6ee9d8 47%, #1bb4b2 53%, #0e8f9b 100%);
+  --gel-borde: rgba(220, 255, 250, 0.75);
+  --gel-texto: #052535;
+  --gel-sombra: rgba(20, 190, 200, 0.45);
+  --orbe: radial-gradient(circle at 32% 26%, #e2fff7 0 9%, #6ee9d8 36%, #109fb2 74%, #0a5f80);
+
+  --cielo: linear-gradient(180deg, #050f27 0%, #0a1f4a 40%, #0d3560 64%, #0b4a63 80%, #083443 100%);
+
+  background: #050f27;
+}
+
+/* ---------- Paisaje ---------- */
+body[data-page="juegos"] .sky {
+  display: none;
+}
+
+/* El cielo va en una capa fija (y no en el fondo de body) para que en
+   móvil no se corte al hacer scroll */
+.escena {
+  position: fixed;
+  inset: 0;
+  z-index: -1;
+  overflow: hidden;
+  background: var(--cielo);
+  pointer-events: none;
+}
+
+/* La luna, brillante como un orbe de cristal */
+.escena-luna {
+  position: absolute;
+  top: 12vh;
+  right: 11vw;
+  width: clamp(100px, 13vw, 180px);
+  aspect-ratio: 1;
+  border-radius: 50%;
+  background: radial-gradient(circle at 36% 32%, #fffdf3 0 16%, #f6ecc4 42%, #dcd2a8 76%, #b9b08a);
+  box-shadow:
+    0 0 50px 8px rgba(241, 228, 174, 0.32),
+    0 0 180px 50px rgba(110, 200, 255, 0.12);
+}
+
+.escena-luna::after {
+  content: '';
+  position: absolute;
+  top: 8%;
+  left: 18%;
+  width: 46%;
+  height: 30%;
+  border-radius: 50%;
+  background: linear-gradient(180deg, rgba(255, 255, 255, 0.7), rgba(255, 255, 255, 0));
+}
+
+/* La laguna: el agua empieza en el horizonte */
+.escena-agua {
+  position: absolute;
+  inset: 72vh 0 0;
+  background: linear-gradient(180deg, rgba(60, 200, 210, 0.22), rgba(6, 40, 60, 0.75));
+  border-top: 1px solid rgba(140, 240, 240, 0.35);
+  box-shadow: 0 -1px 24px rgba(95, 230, 212, 0.25);
+}
+
+/* El reflejo de la luna en el agua, en rayas que se van apagando */
+.escena-reflejo {
+  position: absolute;
+  top: 72vh;
+  bottom: 0;
+  right: calc(11vw + clamp(100px, 13vw, 180px) * 0.2);
+  z-index: 1;
+  width: calc(clamp(100px, 13vw, 180px) * 0.6);
+  background:
+    repeating-linear-gradient(180deg, rgba(241, 228, 174, 0.38) 0 2px, transparent 2px 7px, rgba(241, 228, 174, 0.2) 7px 8px, transparent 8px 14px),
+    radial-gradient(ellipse at 50% 0, rgba(241, 228, 174, 0.22), transparent 70%);
+  -webkit-mask-image: linear-gradient(180deg, #000, transparent 80%), radial-gradient(ellipse at 50% 0, #000 30%, transparent 72%);
+  -webkit-mask-composite: source-in;
+  mask-image: linear-gradient(180deg, #000, transparent 80%), radial-gradient(ellipse at 50% 0, #000 30%, transparent 72%);
+  mask-composite: intersect;
+  filter: blur(1.2px);
+}
+
+/* Burbujas de cristal */
+.burbujas span {
+  position: absolute;
+  border-radius: 50%;
+  background: radial-gradient(circle at 30% 28%,
+    rgba(255, 255, 255, 0.8) 0 7%,
+    rgba(255, 255, 255, 0.12) 22%,
+    rgba(120, 230, 255, 0.05) 60%,
+    rgba(160, 240, 255, 0.28) 100%);
+  border: 1px solid rgba(190, 240, 255, 0.35);
+  box-shadow: inset 0 0 12px rgba(120, 220, 255, 0.25), 0 0 18px rgba(90, 200, 255, 0.14);
+}
+
+.burbujas span:nth-child(1) { top: 18vh; left: 6vw; width: 110px; height: 110px; }
+.burbujas span:nth-child(2) { top: 58vh; left: 3vw; width: 54px; height: 54px; }
+.burbujas span:nth-child(3) { top: 34vh; right: 4vw; width: 64px; height: 64px; }
+.burbujas span:nth-child(4) { top: 80vh; left: 18vw; width: 38px; height: 38px; }
+.burbujas span:nth-child(5) { top: 8vh; left: 44vw; width: 26px; height: 26px; }
+.burbujas span:nth-child(6) { top: 66vh; right: 26vw; width: 84px; height: 84px; }
+.burbujas span:nth-child(7) { top: 88vh; right: 8vw; width: 30px; height: 30px; }
+.burbujas span:nth-child(8) { top: 46vh; left: 30vw; width: 18px; height: 18px; }
+
+/* Flotan muy despacio: es lo único que se mueve solo en la página */
+@media (prefers-reduced-motion: no-preference) {
+  .burbujas span {
+    animation: flota 11s ease-in-out infinite alternate;
+  }
+
+  .burbujas span:nth-child(2n) { animation-duration: 14s; animation-delay: -4s; }
+  .burbujas span:nth-child(3n) { animation-duration: 17s; animation-delay: -9s; }
+}
+
+@keyframes flota {
+  to {
+    transform: translateY(-22px);
+  }
+}
+
+/* ---------- Cabecera ---------- */
+.juegos {
+  width: min(100%, 1120px);
+}
+
+.juegos .section-title {
+  text-shadow: 0 0 28px rgba(95, 230, 212, 0.35);
+}
+
+/* ---------- Tarjetas de cristal ---------- */
+.laguna {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(min(228px, 100%), 1fr));
+  gap: 1.25rem;
+  margin-top: 2.5rem;
+}
+
+.cristal {
+  position: relative;
+  isolation: isolate;
+  display: flex;
+  flex-direction: column;
+  gap: 0.5rem;
+  padding: 1.6rem 1.5rem 1.5rem;
+  overflow: hidden;
+  background: var(--cristal-fondo);
+  border: 1px solid var(--cristal-borde);
+  border-radius: 26px;
+  box-shadow:
+    0 18px 40px rgba(0, 10, 30, 0.45),
+    inset 0 1px 0 rgba(255, 255, 255, 0.35),
+    inset 0 -18px 30px rgba(60, 200, 230, 0.1);
+  -webkit-backdrop-filter: blur(14px) saturate(1.3);
+  backdrop-filter: blur(14px) saturate(1.3);
+  color: var(--papel);
+  transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
+}
+
+/* El brillo de cristal en la mitad de arriba */
+.cristal::before {
+  content: '';
+  position: absolute;
+  inset: 0 0 58% 0;
+  z-index: -1;
+  background: linear-gradient(180deg, var(--cristal-brillo), rgba(255, 255, 255, 0));
+  border-radius: 26px 26px 60% 60% / 26px 26px 25% 25%;
+  pointer-events: none;
+}
+
+a.cristal:hover,
+a.cristal:focus-visible {
+  transform: translateY(-4px);
+  border-color: rgba(200, 245, 255, 0.6);
+  box-shadow:
+    0 22px 46px rgba(0, 10, 30, 0.5),
+    0 0 32px rgba(95, 230, 212, 0.22),
+    inset 0 1px 0 rgba(255, 255, 255, 0.45),
+    inset 0 -18px 30px rgba(60, 200, 230, 0.16);
+}
+
+a.cristal:focus-visible {
+  outline: 2px solid var(--aqua);
+  outline-offset: 4px;
+}
+
+/* Lo que aún no se puede jugar: cristal escarchado y borde a trazos */
+.cristal-escarcha {
+  background: rgba(255, 255, 255, 0.04);
+  border-style: dashed;
+  box-shadow: none;
+}
+
+.cristal-escarcha .orbe {
+  background: radial-gradient(circle at 32% 26%, #f3f6fb 0 9%, #b9c6da 38%, #6d7c98 76%, #47546f);
+  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.25), inset 0 -6px 10px rgba(0, 20, 50, 0.3);
+}
+
+/* El icono, en un orbe de cristal */
+.orbe {
+  position: relative;
+  display: grid;
+  place-items: center;
+  width: 3.5rem;
+  height: 3.5rem;
+  margin-bottom: 0.75rem;
+  border-radius: 50%;
+  background: var(--orbe);
+  box-shadow: 0 6px 18px rgba(20, 180, 200, 0.4), inset 0 -6px 10px rgba(0, 60, 90, 0.35);
+}
+
+.orbe::after {
+  content: '';
+  position: absolute;
+  top: 6%;
+  left: 20%;
+  width: 60%;
+  height: 40%;
+  border-radius: 50%;
+  background: linear-gradient(180deg, rgba(255, 255, 255, 0.85), rgba(255, 255, 255, 0));
+}
+
+.orbe svg {
+  width: 58%;
+  height: 58%;
+  fill: #fff;
+  filter: drop-shadow(0 1px 1px rgba(0, 50, 80, 0.4));
+}
+
+.cristal .estado {
+  padding-top: 0;
+}
+
+.cristal-titulo {
+  font-family: var(--font-title);
+  font-size: 2.1rem;
+  font-weight: 400;
+  line-height: 1.05;
+}
+
+.cristal-texto {
+  flex: 1;
+  color: var(--cristal-texto);
+}
+
+.cristal-dato {
+  font-size: 0.875rem;
+  color: var(--cristal-dato);
+}
+
+/* Botón de gel: brillo arriba y color abajo, como los de antes */
+.gel {
+  align-self: flex-start;
+  margin-top: 0.9rem;
+  padding: 0.6rem 1.4rem;
+  border: 1px solid var(--gel-borde);
+  border-radius: 999px;
+  background: var(--gel);
+  box-shadow: 0 4px 14px var(--gel-sombra), inset 0 1px 0 rgba(255, 255, 255, 0.9);
+  font-size: 0.9375rem;
+  font-weight: 600;
+  white-space: nowrap;
+  color: var(--gel-texto);
+  transition: filter 0.25s ease, box-shadow 0.25s ease;
+}
+
+a.cristal:hover .gel,
+a.cristal:focus-visible .gel {
+  filter: brightness(1.08) saturate(1.1);
+  box-shadow: 0 6px 20px var(--gel-sombra), inset 0 1px 0 #fff;
+}
+
+/* ============================================================
+   DE DÍA: el Frutiger Aero de siempre
+   ============================================================ */
+:root[data-theme="light"] body[data-page="juegos"] {
+  --cristal-fondo: linear-gradient(180deg, rgba(255, 255, 255, 0.85), rgba(190, 235, 255, 0.55));
+  --cristal-borde: rgba(255, 255, 255, 0.95);
+  --cristal-brillo: rgba(255, 255, 255, 0.75);
+  --cristal-texto: #1d5a85;
+  --cristal-dato: #0f7a8a;
+  --gel: linear-gradient(180deg, #c8fbb8 0%, #6fdc63 47%, #2fb34a 53%, #1f9a3c 100%);
+  --gel-borde: rgba(235, 255, 230, 0.9);
+  --gel-texto: #fff;
+  --gel-sombra: rgba(0, 110, 40, 0.35);
+  --orbe: radial-gradient(circle at 30% 25%, #b8ffd0, #27c4a8 55%, #0a8fb8);
+  --papel: #0b3a5e;
+  --grafito: #2a5c80;
+
+  --cielo:
+    radial-gradient(ellipse at 50% 120%, #7be07b 0 25%, transparent 55%),
+    linear-gradient(180deg, #2f9bff 0%, #7fd0ff 45%, #d9f6ff 100%);
+
+  background: #2f9bff;
+}
+
+:root[data-theme="light"] body[data-page="juegos"] .gel {
+  text-shadow: 0 1px 2px rgba(0, 80, 20, 0.45);
+}
+
+:root[data-theme="light"] .juegos .section-title {
+  color: #fff;
+  text-shadow: 0 2px 6px rgba(0, 80, 160, 0.55), 0 0 18px rgba(255, 255, 255, 0.6);
+}
+
+:root[data-theme="light"] .juegos .section-text {
+  color: #0b3a5e;
+  text-shadow: 0 1px 0 rgba(255, 255, 255, 0.7);
+}
+
+:root[data-theme="light"] .cristal {
+  box-shadow:
+    0 8px 24px rgba(0, 90, 170, 0.3),
+    inset 0 1px 0 #fff,
+    inset 0 -10px 20px rgba(80, 190, 255, 0.25);
+}
+
+:root[data-theme="light"] a.cristal:hover,
+:root[data-theme="light"] a.cristal:focus-visible {
+  border-color: #fff;
+  box-shadow:
+    0 12px 30px rgba(0, 120, 220, 0.45),
+    0 0 22px rgba(255, 255, 255, 0.8),
+    inset 0 1px 0 #fff,
+    inset 0 -10px 20px rgba(80, 190, 255, 0.35);
+}
+
+:root[data-theme="light"] a.cristal:focus-visible {
+  outline-color: #0b3a5e;
+}
+
+:root[data-theme="light"] .cristal-escarcha {
+  background: rgba(255, 255, 255, 0.4);
+}
+
+/* De día no hay luna ni laguna: el orbe es una burbuja más y el agua es la colina */
+:root[data-theme="light"] .escena-luna {
+  background: radial-gradient(circle at 36% 32%, rgba(255, 255, 255, 0.95) 0 30%, rgba(230, 248, 255, 0.85));
+  box-shadow: 0 0 40px rgba(255, 255, 255, 0.7);
+}
+
+:root[data-theme="light"] .escena-reflejo,
+:root[data-theme="light"] .escena-agua {
+  display: none;
+}
+
+:root[data-theme="light"] .burbujas span {
+  background: radial-gradient(circle at 30% 28%, rgba(255, 255, 255, 0.95) 0 10%, rgba(255, 255, 255, 0.55) 45%, rgba(255, 255, 255, 0.3));
+  border-color: rgba(255, 255, 255, 0.8);
+  box-shadow: 0 0 20px rgba(255, 255, 255, 0.5);
+}
+
+/* ---------- Móvil ---------- */
+@media (max-width: 600px) {
+  .escena-luna {
+    top: 9vh;
+    right: 6vw;
+  }
+
+  .escena-reflejo {
+    right: calc(6vw + 20px);
+  }
+
+  .burbujas span:nth-child(1),
+  .burbujas span:nth-child(6) {
+    opacity: 0.5;
+  }
+}
diff --git a/public/css/noche.css b/public/css/noche.css
new file mode 100644
index 0000000..09adba9
--- /dev/null
+++ b/public/css/noche.css
@@ -0,0 +1,270 @@
+/* ============================================================
+   NOCHE: la base común de toda la web («Cuaderno de observación»)
+   Letras, colores y piezas compartidas. Se carga después de
+   styles.css en todas las páginas, así que manda sobre él.
+   Cada página puede añadir lo suyo (inicio.css, juegos.css…).
+   ============================================================ */
+
+/* ---------- Letras (servidas desde la propia web) ---------- */
+@font-face {
+  font-family: 'Instrument Serif';
+  src: url('../fonts/instrument-serif-latin-400-normal.woff2') format('woff2');
+  font-weight: 400;
+  font-style: normal;
+  font-display: swap;
+}
+
+@font-face {
+  font-family: 'Instrument Serif';
+  src: url('../fonts/instrument-serif-latin-400-italic.woff2') format('woff2');
+  font-weight: 400;
+  font-style: italic;
+  font-display: swap;
+}
+
+@font-face {
+  font-family: 'Instrument Sans';
+  src: url('../fonts/instrument-sans-latin-standard-normal.woff2') format('woff2');
+  font-weight: 400 700;
+  font-style: normal;
+  font-display: swap;
+}
+
+/* ---------- Colores ---------- */
+/* De noche: tinta azul, papel y luz de luna. El rojo es la linterna roja
+   de observar (no deslumbra): solo marca lo que se puede usar ya. */
+:root {
+  --noche: #101a33;
+  --noche-2: #18244a;
+  --papel: #e9e3d3;
+  --grafito: #9ba2b9;
+  --luz-luna: #f1e4ae;
+  --lampara: #ec6a55;
+  --linea: rgba(233, 227, 211, 0.14);
+  --sombra-luna: #1a2650;
+  --crater: rgba(120, 104, 60, 0.16);
+  --texto-boton: #101a33;
+
+  /* Los nombres de siempre (styles.css y los juegos) siguen a la noche */
+  --black: var(--noche);
+  --dark: var(--noche-2);
+  --dark2: #223061;
+  --white: var(--papel);
+  --white2: #cfc9ba;
+  --gray: var(--grafito);
+  --gray2: #3a4670;
+  --accent: var(--luz-luna);
+  --accent2: var(--luz-luna);
+  --ink-rgb: 233, 227, 211;
+  --bg-rgb: 16, 26, 51;
+  --accent-rgb: 241, 228, 174;
+  --sky-moon: #e9e3d3;
+  --sky-opacity: 0.06;
+
+  --font-title: 'Instrument Serif', 'Times New Roman', serif;
+  --font-text: 'Instrument Sans', system-ui, sans-serif;
+  --font-accent: var(--font-title);
+}
+
+/* De día: el mismo cuaderno a la luz, papel azulado y tinta */
+:root[data-theme="light"] {
+  --noche: #e7eaf0;
+  --noche-2: #dde1ea;
+  --papel: #18213d;
+  --grafito: #4e5672;
+  --luz-luna: #18213d;
+  --lampara: #b8372a;
+  --linea: rgba(24, 33, 61, 0.16);
+  --sombra-luna: #d3d8e3;
+  --crater: rgba(24, 33, 61, 0.08);
+  --texto-boton: #e7eaf0;
+
+  /* styles.css define estos mismos para el modo claro: aquí se repiten para mandar */
+  --black: var(--noche);
+  --dark: var(--noche-2);
+  --white: var(--papel);
+  --gray: var(--grafito);
+  --accent: var(--luz-luna);
+  --accent2: var(--luz-luna);
+  --dark2: #cfd5e1;
+  --white2: #2c3555;
+  --gray2: #c3c9d6;
+  --ink-rgb: 24, 33, 61;
+  --bg-rgb: 231, 234, 240;
+  --accent-rgb: 24, 33, 61;
+  --sky-moon: #8f98b3;
+  --sky-opacity: 0.1;
+}
+
+/* ---------- Base ---------- */
+body {
+  font-size: 1.0625rem;
+  line-height: 1.6;
+  /* La serif solo tiene un grosor: mejor regular que una negrita inventada */
+  font-synthesis: none;
+}
+
+/* El latido de la luna del logo distraía de todo lo demás */
+.moon-icon {
+  animation: none;
+}
+
+.footer-deco {
+  display: none;
+}
+
+/* ---------- Títulos ---------- */
+.section-title,
+.card-title,
+.site-menu nav > a {
+  font-weight: 400;
+}
+
+.section-title {
+  margin-bottom: 1.25rem;
+  font-size: clamp(2.75rem, 6vw, 4.25rem);
+  line-height: 1;
+  letter-spacing: -0.01em;
+}
+
+.card-title {
+  font-size: 1.6rem;
+  line-height: 1.15;
+}
+
+.section-text {
+  max-width: 34em;
+}
+
+.logo {
+  font-weight: 400;
+  font-size: 1.3rem;
+}
+
+/* ---------- Botones ---------- */
+.boton,
+.button-link {
+  display: inline-flex;
+  align-items: center;
+  min-height: 2.75rem;
+  padding: 0.6rem 1.35rem;
+  border: 1px solid rgba(var(--ink-rgb), 0.35);
+  border-radius: 999px;
+  font-size: 0.9375rem;
+  font-weight: 600;
+  color: var(--papel);
+  cursor: pointer;
+  transition: background-color 0.25s ease, border-color 0.25s ease, color 0.25s ease;
+}
+
+.boton:hover,
+.button-link:hover {
+  background: none;
+  border-color: var(--papel);
+  color: var(--papel);
+}
+
+.boton-luz,
+.boton-luz:hover {
+  background: var(--luz-luna);
+  border-color: var(--luz-luna);
+  color: var(--texto-boton);
+}
+
+.boton-luz:hover {
+  background: var(--papel);
+  border-color: var(--papel);
+}
+
+.enlace {
+  font-weight: 600;
+  text-decoration: underline;
+  text-decoration-color: rgba(var(--ink-rgb), 0.35);
+  text-decoration-thickness: 1px;
+  text-underline-offset: 0.25em;
+  transition: text-decoration-color 0.25s ease;
+}
+
+.enlace:hover {
+  text-decoration-color: currentColor;
+}
+
+a:focus-visible,
+button:focus-visible {
+  outline: 2px solid var(--luz-luna);
+  outline-offset: 3px;
+}
+
+/* ---------- Entrada del cuaderno: páginas que aún están por llegar ---------- */
+.entrada {
+  min-height: 70svh;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+}
+
+.entrada-luna {
+  width: 3.5rem;
+  height: 3.5rem;
+  margin-bottom: 2rem;
+}
+
+.entrada-luna .luna-sombra {
+  fill: var(--sombra-luna);
+}
+
+.entrada-luna .luna-luz {
+  fill: var(--luz-luna);
+}
+
+.entrada-luna .luna-borde {
+  fill: none;
+  stroke: rgba(var(--ink-rgb), 0.35);
+  stroke-width: 1.5;
+}
+
+.entrada .section-text {
+  margin-bottom: 2rem;
+  font-size: 1.1875rem;
+}
+
+.entrada .acciones {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.75rem;
+}
+
+/* ---------- Estado de un proyecto ---------- */
+/* Punto rojo encendido: se puede usar ya. Aro: aún no. Punto lleno: código. */
+.estado {
+  display: flex;
+  align-items: baseline;
+  gap: 0.5rem;
+  padding-top: 0.45rem;
+  font-size: 0.8125rem;
+  line-height: 1.35;
+  color: var(--grafito);
+}
+
+.estado-punto {
+  flex-shrink: 0;
+  width: 0.5rem;
+  height: 0.5rem;
+  border: 1.5px solid currentColor;
+  border-radius: 50%;
+}
+
+.estado-jugable {
+  color: var(--papel);
+}
+
+.estado-jugable .estado-punto {
+  background: var(--lampara);
+  border-color: var(--lampara);
+  box-shadow: 0 0 10px var(--lampara);
+}
+
+.estado-codigo .estado-punto {
+  background: currentColor;
+}
+
